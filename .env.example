# assistant 环境配置示例
#
# 环境变量单实例模式（CI / 仓库 workflow 注入用；不读当前目录 ./config.json）。
# 宿主机的常规部署请用 assistant login + config.json：
#   --config / ASSISTANT_CONFIG > <UserConfigDir>/Cosmic-Developers-Union/assistant/config.json
# 令牌也由 assistant login 派生到同目录 credentials.json；下面的 GITEA_ACCESS_TOKEN
# 只用于「没有 config.json」的 CI/单实例场景（reviewer 身份）。

# Gitea 服务器地址（必需，完整的 HTTP/HTTPS URL）
GITEA_HOST=https://gitea.example.com

# Gitea 访问令牌（必需，具有读写仓库权限；环境变量单实例模式下它决定评审身份）
GITEA_ACCESS_TOKEN=your_access_token_here

# 分支保护读取专用令牌（可选，仓库管理员 PAT）
# 分支保护端点要求 repo admin 权限，Actions 内置令牌无法满足；
# 留空时读取被拒会自动回退为「任何失败 context 即阻塞」的严格模式
# GITEA_BRANCH_PROTECTION_TOKEN=your_admin_token_here

# 指定仓库（可选，格式: owner/name）
# 优先级低于命令行 --repo 参数，用于 CI 环境锁定仓库
GITEA_REPOSITORY=owner/repo

# ── 评审会话调度引擎（assistant run / list / review / triage）────────────────
# 调度命令复用上面的 GITEA_HOST / GITEA_ACCESS_TOKEN / GITEA_REPOSITORY：
# 令牌必须是 reviewer 账号（默认 ai）的令牌——会话提交的 Pull Request Review
# 以该令牌账号落库，「reviewer 名下出现新 review」正是完成判定的依据。

# 每轮检测前把宿主检出强制对齐 origin/<基线分支>（部署形态开启；共享开发检出勿开）
# DISPATCH_SYNC_MIRROR=1

# 镜像同步的基线分支（缺省 main）
# DISPATCH_BASE_BRANCH=main

# 空闲轮询间隔（缺省 30s；支持 30s / 10m / 1h / 2d 或毫秒数）
# DISPATCH_INTERVAL_MS=30s

# 单会话超时（缺省 30m；到点 SIGTERM，5s 宽限后 SIGKILL）
# DISPATCH_TIMEOUT_MS=30m

# 每轮待办处理的会话并发数（缺省 1）
# DISPATCH_CONCURRENCY=1

# 会话日志目录（缺省 <仓库根>/logs）
# DISPATCH_LOG_DIR=

# PR worktree 根目录（缺省系统临时目录下 agent-dispatcher/worktrees）
# DISPATCH_WORKTREE_ROOT=

# 单飞锁文件（缺省 <仓库根>/dispatcher.lock）
# DISPATCH_LOCK_FILE=

# 会话模型（缺省用账号默认）
# DISPATCH_MODEL=

# reviewer 账号（完成判定的提交者匹配，缺省 ai）
# DISPATCH_REVIEWER=ai

# claude 可执行文件（PATH 名或绝对路径，缺省 claude；claude CLI 需另行安装并登录）
# DISPATCH_CLAUDE_BIN=claude

# ── 容器部署（docker-compose.yaml 的插值变量；由 docker compose 自动读取本文件）──
# 容器内进程的 UID/GID（缺省 1000:1000；以宿主用户运行，写回挂载目录的属主才不变）
# ASSISTANT_UID=1000
# ASSISTANT_GID=1000

# 挂载进容器的宿主二进制（缺省 ./assistant，即 make build 的产物）
# ASSISTANT_BINARY=./assistant

# daemon 容器使用的镜像名（缺省 ghcr.io/cosmic-developers-union/assistant-daemon:latest；
# 本地由 docker compose 从 images/review/Dockerfile 的 review target 构建）
# DAEMON_IMAGE=ghcr.io/cosmic-developers-union/assistant-daemon:latest
