{
  "$schema": "./schema/config.schema.json",
  "optimizations": {
    "env": {
      "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
      "DISABLE_TELEMETRY": "1",
      "CLAUDE_CODE_EFFORT_LEVEL": "high"
    }
  },
  "default_provider": "zhipu",
  "providers": {
    "zhipu": {
      "api_key": "your-zai-api-key"
    },
    "opencode": {
      "api_key": "sk-zen-...",
      "settings": {
        "model": "claude-sonnet-5"
      }
    },
    "anthropic": {
      "api_key": "sk-ant-api-key"
    }
  },
  "agents": {
    "ops": {
      "provider": "opencode",
      "model": "claude-sonnet-5",
      "session_timeout_ms": 180000
    },
    "qa": {
      "provider": "zhipu",
      "system_prompt": "你是测试助手，只回答与测试相关的问题。",
      "mcp": {
        "fetch": {
          "command": "uvx",
          "args": ["mcp-server-fetch"]
        }
      }
    }
  },
  "default_agent": "ops",
  "instances": [
    {
      "host": "https://gitea.example.com",
      "reviewer": {
        "name": "ai"
      },
      "merger": {
        "name": "merge"
      },
      "repos": [
        {
          "name": "owner/repo"
        },
        {
          "name": "owner/another",
          "dir": "/srv/another",
          "provider": "anthropic"
        }
      ]
    }
  ],
  "weixin": {
    "enabled": true,
    "base_url": "https://ilinkai.weixin.qq.com",
    "bot_token": "created-by-assistant-weixin-login",
    "login_user_id": "wx-user-id",
    "agent": "ops",
    "provider": "opencode",
    "admin_users": [
      "wx-user-id"
    ]
  },
  "qq": {
    "enabled": true,
    "app_id": "your-qq-bot-appid",
    "app_secret": "your-qq-bot-appsecret",
    "agent": "ops",
    "admin_users": [
      "qq-openid-1"
    ]
  },
  "channels": [
    {
      "type": "weixin",
      "name": "work",
      "bot_token": "created-by-assistant-weixin-login--name-work",
      "agent": "ops",
      "admin_users": [
        "wx-user-id"
      ]
    },
    {
      "type": "telegram",
      "bot_token": "123456:ABC-your-botfather-token",
      "agent": "writer",
      "admin_users": [
        "123456789"
      ]
    }
  ]
}
