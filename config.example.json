{
  "optimizations": {
    "env": {
      "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
      "DISABLE_TELEMETRY": "1",
      "CLAUDE_CODE_EFFORT_LEVEL": "high"
    }
  },
  "default_provider": "zhipu",
  "providers": {
    "zhipu": {
      "api_key": "your-zai-api-key"
    },
    "opencode": {
      "api_key": "sk-zen-...",
      "settings": {
        "model": "claude-sonnet-5"
      }
    },
    "anthropic": {
      "api_key": "sk-ant-api-key"
    }
  },
  "instances": [
    {
      "host": "https://gitea.example.com",
      "reviewer": {
        "name": "ai"
      },
      "merger": {
        "name": "merge"
      },
      "repos": [
        {
          "name": "owner/repo"
        },
        {
          "name": "owner/another",
          "dir": "/srv/another",
          "provider": "anthropic"
        }
      ]
    }
  ],
  "weixin": {
    "enabled": true,
    "base_url": "https://ilinkai.weixin.qq.com",
    "bot_token": "created-by-assistant-weixin-login",
    "login_user_id": "wx-user-id",
    "provider": "opencode",
    "admin_users": [
      "wx-user-id"
    ]
  }
}
