{
  "$schema": "./schema/config.schema.json",
  "optimizations": {
    "env": {
      "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
      "DISABLE_TELEMETRY": "1",
      "CLAUDE_CODE_EFFORT_LEVEL": "high"
    }
  },
  "default_provider": "zhipu",
  "providers": {
    "zhipu": {
      "api_key": "$ZHIPU_API_KEY"
    },
    "opencode": {
      "api_key": "$OPENCODE_API_KEY",
      "settings": {
        "model": "claude-sonnet-5"
      }
    },
    "anthropic": {
      "api_key": "$ANTHROPIC_API_KEY"
    }
  },
  "agents": {
    "qa": {
      "description": "测试问答子代理",
      "provider": "zhipu",
      "system_prompt": "你是测试助手，只回答与测试相关的问题。",
      "mcp": {
        "fetch": {
          "command": "uvx",
          "args": ["mcp-server-fetch"]
        },
        "gitea": {
          "command": "assistant",
          "args": ["mcp", "gitea", "--host", "https://gitea.example.com"],
          "env": {
            "GITEA_ACCESS_TOKEN": "$GITEA_REVIEW_TOKEN"
          }
        }
      }
    }
  },
  "sessions": {
    "remote": {
      "url": "http://127.0.0.1:8771",
      "token": "$SESSIONS_TOKEN"
    }
  },
  "channels": [
    {
      "type": "gitea",
      "host": "https://gitea.example.com",
      "token": "${GITEA_REVIEW_TOKEN}",
      "reviewer": "ai",
      "merger": "merge",
      "repos": [
        "owner/repo",
        {
          "name": "owner/another",
          "dir": "/srv/another",
          "provider": "anthropic"
        }
      ]
    },
    {
      "type": "weixin",
      "name": "work",
      "bot_token": "created-by-assistant-weixin-login--name-work",
      "admin_users": [
        "wx-user-id"
      ]
    },
    {
      "type": "qq",
      "app_id": "$QQ_APP_ID",
      "app_secret": "$QQ_TOKEN",
      "admin_users": [
        "*"
      ]
    },
    {
      "type": "telegram",
      "bot_token": "$TELEGRAM_BOT_TOKEN",
      "admin_users": [
        "123456789"
      ]
    }
  ],
  "runtimes": {
    "main": {
      "main_agent": "main",
      "subagents": ["ops", "coder", "writer", "review", "qa"],
      "channels": ["gitea", "weixin/work", "qq", "telegram"],
      "provider": "zhipu",
      "review_name_template": "{instance-name}-{username-or-org}--{name}-{pr|issue}-{index}",
      "api_listen": "127.0.0.1:8770"
    }
  },
  "default_runtime": "main"
}
