{
  "listen": "127.0.0.1:8780",
  "session": {
    "secret": "change-me-random-32-bytes-base64"
  },
  "keys": [
    {
      "name": "assistant",
      "token": "gateway-virtual-token"
    }
  ],
  "models": [
    {
      "id": "deepseek-flash",
      "protocol": "openai-compatible",
      "backend": "opencode-go",
      "api-key": "$OPENCODE_API_KEY"
    },
    {
      "id": "qwen3.8-flash",
      "protocol": "anthropic-messages",
      "backend": "opencode-go",
      "api-key": "$OPENCODE_API_KEY"
    },
    {
      "id": "gpt-5.6-luna",
      "protocol": "openai-responses",
      "backend": "opencode-go",
      "api-key": "$OPENCODE_API_KEY"
    },
    {
      "id": "claude-sonnet-5",
      "protocol": "anthropic-messages",
      "backend": "zhipu",
      "api-key": "$ZAI_API_KEY",
      "model": "glm-5.3-flash[1m]"
    },
    {
      "id": "claude-sonnet-5",
      "protocol": "anthropic-messages",
      "backend": "minimax-cn",
      "api-key": "$MINIMAX_API_KEY",
      "model": "MiniMax-M3[1m]"
    },
    {
      "id": "my-proxy-model",
      "protocol": "openai-compatible",
      "backend": "my-proxy"
    }
  ],
  "backends": {
    "my-proxy": {
      "base_url": "http://127.0.0.1:4000",
      "api-key": "$LITELLM_KEY"
    }
  },
  "residency": {
    "enabled": false,
    "dir": "~/.config/Cosmic-Developers-Union/assistant/ai-gateway-residency"
  }
}
